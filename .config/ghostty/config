# Empty values reset the configuration to the default value
font-family = "Monaspace Radon"
font-family = "Cica"
font-size = 11

# font-feature = "-calt,-liga,-dlig"
cursor-opacity = 0.2
cursor-style = bar

background-opacity = 1
background-blur-radius = 40

theme = rose-pine-dawn
# foreground = #ffffff

window-theme = auto

cursor-style-blink = true

# conf of quickterm
quick-terminal-position = "top"
quick-terminal-screen = "main"
quick-terminal-animation-duration = 0.3
keybind = "global:option+shift+t=toggle_quick_terminal"

# split term
keybind = ctrl+shift+w=close_surface

keybind = ctrl+shift+j=new_split:down
keybind = ctrl+shift+l=new_split:right
keybind = ctrl+shift+k=new_split:up
keybind = ctrl+shift+h=new_split:left

# move splited term
keybind = ctrl+h=goto_split:left
keybind = ctrl+l=goto_split:right
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top

keybind = ctrl+[=resize_split:left,10
keybind = ctrl+]=resize_split:right,10
keybind = ctrl+up=resize_split:up,10
keybind = ctrl+down=resize_split:down,10

# disable toggle fullscreen
keybind = super+enter=unbind
keybind = ctrl+enter=unbind

window-inherit-working-directory = true
term=xterm-256color

notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 5s
