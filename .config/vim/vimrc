let s:plug = expand('~/.config/vim/autoload/plug.vim')
if empty(glob(s:plug))
  silent execute '!curl -fLo ' . s:plug . ' --create-dirs
    \ https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

let &t_SI = "\e[6 q"
let &t_SR = "\e[4 q"
let &t_EI = "\e[2 q"

let mapleader = " "

set number
set relativenumber
set wildmenu
set wildoptions=fuzzy,pum
set wildmode=noselect:lastused,full
set path+=**
nnoremap <C-p> :find<Space>

inoremap jj <Esc>

augroup cursor_reset
  autocmd!
  autocmd VimEnter * silent !echo -ne "\e[2 q"
  autocmd VimLeave * silent !echo -ne "\e[ q"

function! s:UpdateBranch() abort
  let l:dir = shellescape(expand('%:p:h'))
  let l:out = system('git -C ' . l:dir . ' branch --show-current 2>/dev/null')
  let b:git_branch = v:shell_error ? '' : trim(l:out)
endfunction

augroup git_branch
  autocmd!
  autocmd BufEnter,BufWritePost,FocusGained * call s:UpdateBranch()
augroup END

set laststatus=2
set noshowmode

let g:modes = {'n': 'NORMAL', 'i': 'INSERT', 'R': 'REPLACE', 'v': 'VISUAL', 'V': 'V-LINE', "\<C-v>": 'V-BLOCK', 'c': 'COMMAND', 't': 'TERMINAL'}

set statusline=\ %{get(g:modes,mode(),mode())}\ %{get(b:,'git_branch','')}\ %f\ %m%r%=%y\ %p%%\ %l:%c

augroup statusline_color
  autocmd!
  autocmd InsertEnter * highlight StatusLine ctermfg=Black ctermbg=Green
  autocmd InsertLeave * highlight StatusLine ctermfg=Black ctermbg=Blue
augroup END

call plug#begin()
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'
call plug#end()
