{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "color": {
      "1": "#58B3E8",
      "2": "#3C9FE6",
      "3": "#294172"
    },
    "padding": {
      "top": 1,
      "left": 4
    }
  },

  "display": {
    "separator": " ",
    "color": {
      "keys": "#F962C9",
      "title": "#F72576",
      "separator": "#a29bfe",
      "1": "#F962C9"
    }
  },

  "modules": [
    {
      "type": "custom",
      "format": "{##a29bfe}╭──────────────── System ────────────────╮ "
    },

    {
      "type": "os",
      "key": "{##a29bfe}│  󰍹 OS      "
    },
    {
      "type": "host",
      "key": "{##a29bfe}│  󰟀 Host    "
    },
    {
      "type": "kernel",
      "key": "{##a29bfe}│   Kernel  "
    },
    {
      "type": "uptime",
      "key": "{##a29bfe}│  󰅐 Uptime  "
    },
    {
      "type": "custom",
      "format": "{##a29bfe}╰────────────────────────────────────────╯"
    },

    {
      "type": "custom",
      "format": "{##fdcb6e}╭─────────────── Software ───────────────╮ "
    },

    {
      "type": "de",
      "key": "{##fdcb6e}│  󰧨 DE      "
    },
    {
      "type": "wm",
      "key": "{##fdcb6e}│  󱂬 WM      "
    },
    {
      "type": "packages",
      "key": "{##fdcb6e}│   Packages"
    },

    {
      "type": "shell",
      "key": "{##fdcb6e}│  󰞷 Shell   "
    },
    {
      "type": "terminal",
      "key": "{##fdcb6e}│   Terminal"
    },

    {
      "type": "custom",
      "format": "{##fdcb6e}╰────────────────────────────────────────╯"
    },

    {
      "type": "custom",
      "format": "{##00b894}╭─────────────── Hardware ───────────────╮ "
    },

    {
      "type": "display",
      "key": "{##00b894}│  󰍹 Display "
    },
    {
      "type": "command",
      "key": "{##00b894}│  󰻠 CPU     ",
      "text": "$HOME/dotfiles/script/cpu-info.sh"
    },
    {
      "type": "gpu",
      "key": "{##00b894}│  󰢮 GPU     "
    },
    {
      "type": "command",
      "key": "{##00b894}│  󰍛 Memory  ",
      "text": "$HOME/dotfiles/script/memory-info.sh"
    },
    {
      "type": "command",
      "key": "{##00b894}│  󰍛 Cache   ",
      "text": "$HOME/dotfiles/script/memory-info.sh cache"
    },
    {
      "type": "swap",
      "key": "{##00b894}│  󰾴 Swap    "
    },
    {
      "type": "battery",
      "key": "{##00b894}│  󰁹 Battery "
    },
    {
      "type": "command",
      "key": "{##00b894}│  󰋊 Disk    ",
      "text": "df -B1 --output=used,size,pcent,fstype / | awk 'NR==2{printf \"%.1fGiB / %.1fGiB (%s) - %s\\n\", $1/1024/1024/1024, $2/1024/1024/1024, $3, $4}'"
    },

    {
      "type": "custom",
      "format": "{##00b894}╰────────────────────────────────────────╯"
    },

    {
      "type": "colors",
      "key": " ",
      "symbol": "circle"
    }
  ]
}
